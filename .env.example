# ---------------------------------------------------------------------------
# GeoVision — environment template
#
# Copy to `.env` and fill in.  `.env` is git-ignored and must NEVER be committed.
# Every setting is read by backend/app/core/config.py (prefix: GV_).
# The app FAILS TO START if a required secret is missing outside local dev —
# that is deliberate: a silent insecure default is worse than a loud crash.
#
#   cp .env.example .env
#   python scripts/generate_secrets.py     # fills the secret values for you
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
GV_ENVIRONMENT=local                 # local | ci | staging | production
GV_DEBUG=true
GV_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
GV_LOG_FORMAT=console                # console (readable, dev) | json (production)

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
GV_JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_urlsafe_secret
GV_ACCESS_TOKEN_TTL_MINUTES=15
GV_REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated. Never use "*" together with credentials — browsers reject it.
GV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Port 5433 on purpose: Windows machines frequently already run a local
# PostgreSQL on 5432, and the clash produces a very confusing auth error.
GV_POSTGRES_HOST=localhost
GV_POSTGRES_PORT=5433
GV_POSTGRES_USER=geovision
GV_POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
GV_POSTGRES_DB=geovision
GV_DB_ECHO=false                     # true = log every SQL statement (noisy)
GV_DB_POOL_SIZE=10
GV_DB_MAX_OVERFLOW=20

# --- Redis (Celery broker + result backend + WS pub/sub + nonce cache) ------
GV_REDIS_HOST=localhost
GV_REDIS_PORT=6379
GV_REDIS_DB=0

# --- Object storage (MinIO in dev, any S3-compatible service in prod) ------
# `local` writes to the filesystem so the project runs with nothing installed.
# It is REFUSED in staging/production: no replication, no lifecycle rules, no
# real signed URLs — unacceptable for a project's only copy of its imagery.
GV_STORAGE_BACKEND=local             # local | s3
GV_LOCAL_STORAGE_PATH=./storage
GV_S3_ENDPOINT_URL=http://localhost:9000
GV_S3_ACCESS_KEY=geovision
GV_S3_SECRET_KEY=CHANGE_ME_local_dev_password
GV_S3_BUCKET=geovision
GV_S3_REGION=us-east-1
GV_S3_USE_SSL=false

# --- Uploads ---------------------------------------------------------------
GV_MAX_IMAGE_UPLOAD_BYTES=8388608    # 8 MB  — ESP32 captures target <= 500 KB
GV_MAX_ASSET_UPLOAD_BYTES=26214400   # 25 MB — blueprints / 3D renders

# --- Device ingest (see 05-Hardware/Device-Pairing-Protocol.md) ------------
GV_DEVICE_CLOCK_SKEW_SECONDS=300     # HMAC replay window, +/- 5 minutes
GV_PAIRING_TOKEN_TTL_MINUTES=15
GV_MAX_CAPTURE_FUTURE_HOURS=24       # Beyond this the device clock is corrupt
GV_MIN_IMAGE_WIDTH=320               # Smaller means the sensor failed to warm up
GV_MIN_IMAGE_HEIGHT=240

# Encrypts device secrets at rest. NOT a hash — HMAC verification needs the key
# back, so it must be recoverable (ADR-020). Losing or rotating this value
# un-pairs every camera; they must be re-provisioned.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in staging/production; local dev falls back to a fixed dev key.
GV_DEVICE_SECRET_KEY=

# Replay protection. `memory` is per-process, so it stops protecting the moment
# a second worker exists — refused in staging/production for that reason.
GV_NONCE_CACHE_BACKEND=memory        # memory | redis

# Used to build the pairing QR the camera scans during provisioning, so it must
# be the URL the DEVICE can reach — not localhost, if it is on real Wi-Fi.
GV_PUBLIC_BASE_URL=http://localhost:8000

# --- AI / inference (wired up in Module 09) --------------------------------
GV_MODEL_DIR=./models
GV_INFERENCE_DEVICE=auto             # auto | cpu | cuda
# Relative paths resolve against GV_MODEL_DIR, e.g. classifier/resnet18/v1/best.pt
# -> ./models/classifier/resnet18/v1/best.pt. Leave empty to use the stub.
GV_CLASSIFIER_WEIGHTS=              # empty until you have a trained checkpoint
GV_DETECTOR_WEIGHTS=                # empty until Module 08 produces one (needs annotation)
# With no classifier weights the service uses the deterministic StubClassifier so
# that Modules 09-14 are fully buildable before the dataset exists. With no
# detector weights it runs with no detector at all, not a stub one — a stub
# detector would inject made-up boxes into a real classifier's fused progress
# score (see ai/inference/service.py's build_service).
GV_USE_STUB_MODELS=true

# --- Project defaults ------------------------------------------------------
GV_DEFAULT_TIMEZONE=Asia/Manila
